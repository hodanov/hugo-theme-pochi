{
  "$comment": "Token pairs checked by scripts/check-contrast.mjs. fg/bg name tokens in assets/css/tokens.css; bg may be a list from top to bottom (translucent layers are composited). min: 4.5 for text, 3 for non-text (WCAG 1.4.11). apcaMin: the APCA Lc body text must also reach (Lc 75). Links in running text are underlined, so they need no contrast against the text around them. known: audit ID per theme for a failure already tracked in docs/plan/2026-10-19_design-refinement-roadmap.md; remove it once the pair passes.",
  "pairs": [
    {
      "id": "text-on-bg",
      "fg": "--pochi-text",
      "bg": "--pochi-bg",
      "min": 4.5,
      "apcaMin": 75,
      "use": "本文（main-content の背景）"
    },
    {
      "id": "text-on-card",
      "fg": "--pochi-text",
      "bg": "--pochi-card",
      "min": 4.5,
      "apcaMin": 75,
      "use": "カード・ナビ・入力欄の文字"
    },
    {
      "id": "text-on-surface-soft",
      "fg": "--pochi-text",
      "bg": "--pochi-surface-soft",
      "min": 4.5,
      "apcaMin": 75,
      "use": "body の文字"
    },
    {
      "id": "text-on-blockquote",
      "fg": "--pochi-text",
      "bg": "--pochi-blockquote-bg",
      "min": 4.5,
      "apcaMin": 75,
      "use": "引用"
    },
    {
      "id": "text-on-hover",
      "fg": "--pochi-text",
      "bg": ["--pochi-hover", "--pochi-card"],
      "min": 4.5,
      "use": "ホバー中の行"
    },
    {
      "id": "muted-on-card",
      "fg": "--pochi-text-muted",
      "bg": "--pochi-card",
      "min": 4.5,
      "use": "日付・タグ・サイドバーの補助テキスト"
    },
    {
      "id": "muted-on-bg",
      "fg": "--pochi-text-muted",
      "bg": "--pochi-bg",
      "min": 4.5,
      "use": "ページネーション・パンくず"
    },
    {
      "id": "link-on-card",
      "fg": "--pochi-link",
      "bg": "--pochi-card",
      "min": 4.5,
      "use": "カード内のリンク"
    },
    {
      "id": "link-on-bg",
      "fg": "--pochi-link",
      "bg": "--pochi-bg",
      "min": 4.5,
      "use": "本文のリンク"
    },
    {
      "id": "on-accent",
      "fg": "--pochi-on-accent",
