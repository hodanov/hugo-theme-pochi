{
  "scripts": {
    "e2e": "playwright test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "prettier . --check && npm run lint:css && npm run lint:contrast",
    "lint:css": "node scripts/lint-css.mjs",
    "lint:css:update": "node scripts/lint-css.mjs --update",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:html": "bash scripts/build-site.sh .snapshot/html && node scripts/lint-html.mjs .snapshot/html",
    "lint:html:update": "bash scripts/build-site.sh .snapshot/html && node scripts/lint-html.mjs .snapshot/html --update",
    "serve": "hugo serve -s example_site --themesDir ../.. -t pochi",
    "build": "hugo --gc -s example_site --themesDir ../.. -t pochi",
    "build:snapshot": "bash scripts/build-site.sh .snapshot/site --minify --baseURL http://127.0.0.1:4173/",
    "vrt": "bash scripts/pw-docker.sh --project=vrt",
    "vrt:update": "bash scripts/pw-docker.sh --project=vrt --update-snapshots=changed",
    "a11y": "bash scripts/pw-docker.sh --project=a11y",
    "a11y:update": "A11Y_UPDATE=1 bash scripts/pw-docker.sh --project=a11y --update-snapshots=changed",
    "lighthouse": "npm run build:snapshot && node scripts/lighthouse.mjs",
    "style:diff": "node scripts/style-diff.mjs",
    "vendor:sync": "node scripts/vendor-sync.js",
    "vendor:verify": "node scripts/vendor-sync.js --verify",
    "vendor:update": "npm update fuse.js mark.js modern-normalize --save-dev && npm run vendor:sync",
    "vendor:upgrade:major": "npx npm-check-updates -u --filter fuse.js,mark.js,modern-normalize && npm i && npm run vendor:sync"
  },
  "dependencies": {
    "@fsouza/prettierd": "^0.29.0",
    "prettier": "^3.9.9",
    "prettier-plugin-go-template": "^0.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "chrome-launcher": "^1.2.2",
    "colorjs.io": "^0.7.1",
    "fuse.js": "^7.1.0",
    "html-validate": "^11.16.2",
    "lighthouse": "^13.5.0",
    "mark.js": "^8.11.1",
    "modern-normalize": "^3.0.1",
    "npm-check-updates": "^23.1.0",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.30",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^7.0.2"
  }
}
